# nginx.conf가 include하는 실제 시크릿 값 파일의 예시.
# VM에서 이 내용을 /etc/nginx/snippets/toss-proxy-secret.conf 로 직접 만들고
# REPLACE_ME를 실제 값(앱의 TOSS_PROXY_SHARED_SECRET과 동일한 값)으로 채운다.
# /etc/nginx/conf.d/에 두면 안 된다 — nginx.conf 참고.
# 이 파일 자체(*-secret.conf)는 .gitignore로 커밋되지 않는다 — 값은 저장소에 남기지 않는다.

set $toss_proxy_secret "REPLACE_ME";
